{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "映框",
  "version": "0.5.8-beta.7",
  "identifier": "com.ming.yingkuang",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "映框",
        "decorations": false,
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: ws://localhost:* ws://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/MIT.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../public/fonts/allura/OFL.txt": "licenses/fonts/allura/OFL.txt",
      "../public/fonts/cinzel/OFL.txt": "licenses/fonts/cinzel/OFL.txt",
      "../public/fonts/cormorantgaramond/OFL.txt": "licenses/fonts/cormorantgaramond/OFL.txt",
      "../public/fonts/longcang/OFL.txt": "licenses/fonts/longcang/OFL.txt",
      "../public/fonts/sacramento/OFL.txt": "licenses/fonts/sacramento/OFL.txt",
      "../public/fonts/spacemono/OFL.txt": "licenses/fonts/spacemono/OFL.txt"
    }
  }
}
